{
  "manifest_version": 2,
  "name": "Chess Assist — Stockfish",
  "short_name": "Chess Assist",
  "version": "0.4.1",
  "description": "Подсказывает лучший ход Stockfish на chess.com и lichess.org. Есть необязательный автоход.",
  "author": "Chess Assist",
  "browser_specific_settings": {
    "gecko": {
      "id": "chess-assist@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://lichess.org/*",
    "https://*.lichess.org/*",
    "https://tablebase.lichess.ovh/*"
  ],
  "background": {
    "scripts": [
      "content/lib/core.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Chess Assist — Stockfish",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chess.com/*",
        "https://*.chess.com/*",
        "https://lichess.org/*",
        "https://*.lichess.org/*"
      ],
      "js": [
        "content/vendor/chess.global.js",
        "content/lib/core.js",
        "content/sites/adapters.js",
        "content/overlay.js",
        "content/page-bridge-client.js",
        "content/automove.js",
        "content/engine-client.js",
        "content/content.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
  "web_accessible_resources": [
    "content/page-bridge.js"
  ]
}
